{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lectura Rápida",
  "version": "1.0.0",
  "identifier": "com.lectura.rapida",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lectura Rápida · Entrenador RSVP",
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Entrenador local de lectura rápida",
    "longDescription": "Aplicación de escritorio para entrenar velocidad lectora, comprensión y campo visual mediante RSVP, tests y tablas de Schulte. Todo el dato se guarda en SQLite local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
